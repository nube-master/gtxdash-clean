          "properties": {}
        },
        "outputSchema": null
      },
      {
        "name": "list_creatives",
        "title": "List Meta Creatives Performance",
        "description": "Returns aggregated performance metrics per creative [AD##] for the last 30 days.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "http://json-schema.org/draft-07/schema#",
          "type": "object",
          "properties": {
            "min_spend": {
              "description": "Minimum spend in BRL",
              "type": "number"
            },
            "limit": {
              "default": 50,
              "description": "Maximum results",
              "type": "integer",
              "minimum": 1,
              "maximum": 200
            }
          }
        },
        "outputSchema": null
      },
      {
        "name": "get_creative_by_code",
        "title": "Get Creative Detail by Code",
        "description": "Returns detailed metrics for a creative ID such as AD125.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "http://json-schema.org/draft-07/schema#",
          "type": "object",
          "properties": {
            "ad_code": {
              "type": "string",
              "minLength": 1,
              "description": "Creative code, for example AD125"
            }
          },
          "required": [
            "ad_code"
          ]
        },
        "outputSchema": null
      },
      {
        "name": "list_ad_accounts",
        "title": "List Meta Ad Accounts",
        "description": "List Meta ad accounts linked to Traffic OS.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "http://json-schema.org/draft-07/schema#",
          "type": "object",
          "properties": {}
        },
        "outputSchema": null
      },
      {
        "name": "list_orders",
        "title": "List COD Affiliate Orders",
        "description": "Lists webhook-received Sphere/Fahto COD orders for one operation, newest first, using opaque cursor pagination. Filters combine with AND. delivered_date is a calendar date (no time).",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "http://json-schema.org/draft-07/schema#",
          "type": "object",
          "properties": {
            "from": {
              "type": "string",
              "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
              "description": "Required UTC start date, YYYY-MM-DD"
            },
            "to": {
              "type": "string",
              "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
              "description": "Required UTC end date, YYYY-MM-DD"
            },
            "operation_id": {
              "type": "string",
              "format": "uuid",
              "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$",
              "description": "Required operation UUID"
            },
            "platform": {
              "default": "all",
              "type": "string",
              "enum": [
                "sphere",
                "fahto",
                "all"
              ]
            },
            "status": {
              "default": "all",
              "type": "string",
              "enum": [
                "paid",
                "pending",
                "refused",
                "expired",
                "delivered",
                "all"
              ]
            },
            "program": {
              "description": "Exact program id / slug, case-insensitive (AND filter)",
              "type": "string",
              "minLength": 1
            },
            "cursor": {
              "description": "Opaque cursor returned by the previous page",
              "type": "string"
            },
            "limit": {
              "default": 100,
              "type": "integer",
              "minimum": 1,
              "maximum": 200
            },
            "include_total": {
              "default": true,
              "type": "boolean"
            }
          },
          "required": [
            "from",
            "to",
            "operation_id"
          ]
        },
        "outputSchema": null
      },
